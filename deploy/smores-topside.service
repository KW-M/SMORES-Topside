# SMORES-Topside backend, run as the `pi` user under systemd.
#
# Install (see README.md "Running as a systemd service" for the full walkthrough):
#   sudo cp deploy/smores-topside.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smores-topside.service
#
# The listen address and port come from `api_host`/`api_port` in
# ~/SMORES_Data/config.json, not from this unit; port 80 is permitted (see
# AmbientCapabilities= below).
#
# ExecStart below points at this repo's pipenv virtualenv. The venv directory
# name is derived deterministically from the project path, so it stays valid
# across `pipenv install` re-runs as long as the repo lives at
# /home/pi/SMORES-Topside. If you move the repo or use a different venv,
# re-point ExecStart at the output of `pipenv --venv`.

[Unit]
Description=SMORES-Topside dissolved oxygen sensor array backend
Documentation=file:///home/pi/SMORES-Topside/README.md
After=network-online.target
Wants=network-online.target

# No start rate limit: this is an unattended field instrument, and
# `PUT /api/config` restarts the process on purpose. The default limit
# (5 starts / 10 s) would latch the unit into `failed` after a handful of
# config changes, or after a few early crashes, and stop retrying.
StartLimitIntervalSec=0

[Service]
Type=exec
User=pi
Group=pi
# The RS485-to-USB converters appear as /dev/ttyUSB* (group `dialout`).
# `pi` is normally already a member; this makes the unit work regardless.
SupplementaryGroups=dialout

WorkingDirectory=/home/pi/SMORES-Topside

# Config file and SQLite DB location. This is the default the code would pick
# anyway (`~/SMORES_Data`), stated explicitly so the service's data path does
# not depend on the resolved home directory of whatever user runs it.
Environment=SMORES_DATA_DIR=/home/pi/SMORES_Data
# Unbuffered stdout, so log lines reach journald as they happen instead of in
# 8 KiB blocks.
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/pi/.local/share/virtualenvs/SMORES-Topside-DhRf5Al6/bin/python /home/pi/SMORES-Topside/src/main.py

# `Restart=always`, not `on-failure`: `PUT /api/config` persists the new config
# and then takes the normal SIGTERM shutdown path, so the process exits 0 and
# still needs to come back up. A missing serial adapter is deliberately *not*
# fatal (main.py keeps the API serving so the config can be corrected), so this
# does not mask hardware faults into a restart loop.
Restart=always
RestartSec=2

# Graceful shutdown: SIGTERM is what main.py's handler waits for. 30 s is far
# more than teardown needs (cancel tasks, close serial ports, close the DB);
# a second SIGTERM after the first is not swallowed, so `systemctl stop` on an
# already-stopping process still terminates it.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smores-topside

# Allow binding privileged ports (< 1024) while still running as `pi`, so
# setting `"api_port": 80` in config.json Just Works without running the
# backend as root. systemd grants the capability across the drop to `pi` (it
# adds keep-caps to SecureBits= automatically for ambient capabilities);
# NoNewPrivileges= below does not interfere, since the capability is already
# in place at exec rather than gained through it. The bounding set is narrowed
# to the same single capability, so this is the only privilege the process can
# ever hold. Remove both lines if you never serve below port 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Light hardening. Note PrivateTmp= gives the service its own /tmp, so if you
# ever re-point SMORES_DATA_DIR at a path under /tmp the service will silently
# get a private empty one instead of yours; keep the data directory outside
# /tmp. Deliberately no PrivateDevices=/DeviceAllow= restrictions:
# the whole job of this service is to open USB serial adapters via
# /dev/serial/by-id -> /dev/ttyUSB*. ProtectHome= is likewise unset, since both
# the code and the data directory live under /home/pi.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
